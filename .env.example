# Copy to .env and adjust for your environment.
ENVIRONMENT=development
DEBUG=true

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-6f4b1c0e8a2d4f7b9c3e5a1d
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite file lives next to the project root by default.
DATABASE_URL=sqlite:///./brightloop.db

# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Used to build the password reset link that is emailed out.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# Serve the built SvelteKit SPA from FastAPI (run `npm run build` first).
SERVE_FRONTEND=true
FRONTEND_BUILD_DIR=frontend/build

# Seeds an admin/staff/customer account plus demo catalogue & billing data on first boot.
SEED_DEMO_DATA=true
